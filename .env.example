# ─── ATTIRA — environment ─────────────────────────────────────────────────────
# Copy to .env.local and fill in. The app boots in a graceful "degraded mode"
# when these are absent (the design preview works; auth-gated pages explain
# what's missing), so you only need what you're actually testing.

# Supabase — required for auth, the database, and the Memory Engine.
# Project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY, never exposed to the browser. Used for
# confirmed sign-up and the nightly pattern job. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used in redirects). Optional in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional — the intelligence layer ───────────────────────────────────────
# Anthropic API — powers the nightly pattern extraction (and, later, coaching).
# Without it, the pattern job simply skips. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Embeddings for semantic memory retrieval (OpenAI-compatible). Without it,
# retrieval degrades to recency — never required.
EMBEDDINGS_API_KEY=
EMBEDDINGS_API_URL=https://api.openai.com/v1/embeddings
EMBEDDINGS_MODEL=text-embedding-3-small

# Shared secret protecting POST /api/jobs/patterns. Set to any long random
# string; pass it as `Authorization: Bearer <value>` when triggering the job.
CRON_SECRET=
