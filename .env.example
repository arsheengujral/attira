# ─── ATTIRA — environment ─────────────────────────────────────────────────────
# Copy to .env.local and fill in. The app boots in a graceful "degraded mode"
# when these are absent (the design preview works; auth-gated pages explain
# what's missing), so you only need what you're actually testing.

# Supabase — required for auth, the database, and the Memory Engine.
# Project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY, never exposed to the browser. Used for
# confirmed sign-up and the nightly pattern job. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used in redirects). Optional in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional ─────────────────────────────────────────────────────────────────
# The Skin Coach, personalized results, and the nightly pattern job are all
# RULE-BASED — they use the static knowledge in docs/scaffold-skin.md and cost
# nothing. There is NO Anthropic / LLM API key to set.

# Embeddings for semantic memory retrieval (OpenAI-compatible). OFF by default;
# without it, retrieval simply uses recency. Never required — leave blank to keep
# the app fully zero-cost.
EMBEDDINGS_API_KEY=
EMBEDDINGS_API_URL=https://api.openai.com/v1/embeddings
EMBEDDINGS_MODEL=text-embedding-3-small

# Shared secret protecting POST /api/jobs/patterns (the rule-based nightly job).
# Set to any long random string; pass it as `Authorization: Bearer <value>`.
CRON_SECRET=
